source_directories_must_exist: true
source_directories:
{% for directory in backup_dirs %}
  - {{ directory }}
{% endfor %}
exclude_patterns:
  - "*/.stfolder"

repositories:
  - path: /var/backups/borg/horrea
    label: local
    encryption: repokey-blake2
  - path: ssh://{{ borgbase_repo_id }}@{{ borgbase_repo_id }}.repo.borgbase.com/./repo
    label: borgbase
    encryption: repokey-blake2

keep_daily: 7
keep_weekly: 5
keep_monthly: 12
keep_yearly: -1 # forever
